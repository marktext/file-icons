{
  "name": "@marktext/file-icons",
  "version": "1.0.6",
  "description": "atom file icons",
  "main": "./build/index.js",
  "module": "./build/index.mjs",
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/finalize-types.mjs",
    "build:example": "vite build --mode example",
    "preview": "vite preview --mode example",
    "test": "pnpm run typecheck && pnpm run build && node test/build.cjs && tsc -p test/tsconfig.json",
    "test:package": "node test/package.mjs",
    "prepack": "pnpm run typecheck && pnpm run build",
    "pub": "pnpm publish"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marktext/file-icons.git"
  },
  "keywords": [
    "file",
    "icons"
  ],
  "author": "Jocs",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/marktext/file-icons/issues"
  },
  "homepage": "https://github.com/marktext/file-icons#readme",
  "devDependencies": {
    "@types/node": "^22.0.0",
    "file-icons": "https://codeload.github.com/file-icons/atom/tar.gz/248da1c65beeaad5e8922d66d1d977742260bab2",
    "less": "^4.6.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "types": "./build/index.d.cts",
  "exports": {
    ".": {
      "import": {
        "types": "./build/index.d.mts",
        "default": "./build/index.mjs"
      },
      "require": {
        "types": "./build/index.d.cts",
        "default": "./build/index.js"
      }
    },
    "./build/*": "./build/*",
    "./package.json": "./package.json"
  },
  "packageManager": "pnpm@12.18.0"
}
